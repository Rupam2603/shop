# ────────────────────────────────────────────────────────────────────────────
# SubhOne — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Find these in your Supabase dashboard → Project Settings → API

# Your project URL (safe to expose in frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — safe in browser because Row Level Security protects your data
# NEVER use the service_role key here — it bypasses ALL security policies
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ────────────────────────────────────────────────────────────────────────────
# SECURITY REMINDER:
#   - VITE_SUPABASE_URL          → safe to expose ✅
#   - VITE_SUPABASE_ANON_KEY     → safe to expose ✅ (protected by RLS)
#   - service_role / secret key  → NEVER put in frontend ❌
# ────────────────────────────────────────────────────────────────────────────
