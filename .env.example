# ────────────────────────────────────────────────────────────────────────────
# SubhOne — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git, and never hardcode these as fallbacks in source.
# ────────────────────────────────────────────────────────────────────────────

# ── Neon Auth (Managed Better Auth) — REQUIRED ───────────────────────────────
# Neon Console → your project → Auth → Configuration → Base URL
VITE_NEON_AUTH_API=https://ep-xxxxxxxx.neonauth.c-x.region.aws.neon.tech/neondb/auth

# ── Neon Data API — REQUIRED ─────────────────────────────────────────────────
# Neon Console → your project → Postgres database → Data API → REST URL
VITE_NEON_DATA_API=https://ep-xxxxxxxx.apirest.c-x.region.aws.neon.tech/neondb/rest/v1

# ────────────────────────────────────────────────────────────────────────────
# SECURITY REMINDER:
#   - Both URLs above are safe to expose in the frontend ✅ — access is
#     enforced by Postgres Row-Level Security on the Neon Data API, not by
#     keeping these URLs secret.
#   - NEVER put a raw Postgres connection string / DATABASE_URL (with a
#     password in it) in a VITE_-prefixed variable or anywhere in src/ — Vite
#     inlines VITE_ vars into the client bundle, shipping it to every visitor.
# ────────────────────────────────────────────────────────────────────────────# ── Google Maps API Key — Location Tracking ──────────────────────────────
VITE_GOOGLE_MAP_API=AIzaSyD60FUI15GBZFVqcB_yTXGMsqtB-yukXIk
VITE_GOOGLE_MAPS_API_KEY=AIzaSyD60FUI15GBZFVqcB_yTXGMsqtB-yukXIk
